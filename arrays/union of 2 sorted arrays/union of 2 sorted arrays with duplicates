class Solution {
  public:
    vector<int> findUnion(vector<int> &a, vector<int> &b) {
        
        int n =a.size(); int m =b.size(); vector<int>res; 
        int i=0; int j=0;
        
        while(i<n && j<m) {       //better than loop
        
          if( i >0 && a[i-1] == a[i]){ i++; continue; } //i=0 justin res i=1 start
          
          if( j >0 && b[j-1] == b[j]){ j++; continue; }
           
            if (a[i] < b[j]) {
            res.push_back(a[i]); i++; }
            
            else if (a[i] > b[j]) {
            res.push_back(b[j]); j++; }
            
            else {
            res.push_back(a[i]); i++; j++; }
            
        }
        
        while( j < m) { //extra remaining elements
            if( j >0 && b[j-1] == b[j]){ j++; continue; }
            res.push_back(b[j]); j++; }
            
        while( i < n) { 
            if( i >0 && a[i-1] == a[i]){ i++; continue; }
            res.push_back(a[i]); i++; }
            
    return res;
        
    }
};
